type Categoria {
    id: ID!
    nombre: String!
    icono: String
    tipo: String!
    grupo: GrupoGasto
}

type Presupuesto {
    id: ID!
    categoria: Categoria!
    monto: Float!
    mes: Int!
    anio: Int!
}

type PagoCompartido {
    id: ID!
    persona: Persona!
    monto: Float!
    formaPago: String
    fecha: String
}

type Gasto {
    id: ID!
    amount: Float!
    categoria: Categoria
    date: String!
    description: String
    formaPago: String
    recurrent: Boolean
    pagado: Boolean
    fechaVencimiento: String
    fechaPago: String
    persona: Persona
    esCompartido: Boolean
    pagosCompartidos: [PagoCompartido]
    cuotaActual: Int
    cuotasTotales: Int
}

type Persona {
    id: ID!
    nombre: String!
    creadoEn: String
    activo: Boolean
    tieneClave: Boolean
}

type LoginResult {
    token: String!
    persona: Persona!
}

type Ingreso {
    id: ID!
    monto: Float!
    fecha: String!
    categoria: Categoria
    recurrent: Boolean
    persona: Persona
}

type LastRecordsDates {
    lastGasto: String
    lastIngreso: String
    lastBalance: String
}

type Compra {
    id: ID!
    nombre: String!
    precio: Float
    lugar: String
    comprado: Boolean
    fechaRegistro: String
}

type Ahorro {
    id: ID!
    monto: Float!
    fecha: String!
    descripcion: String
    persona: Persona
}

type CierreResult {
    gastosCopiados: Int!
    ingresosCopiados: Int!
    gastosOmitidos: Int!
    ingresosOmitidos: Int!
}

# --- Guía de distribución del ingreso (50/30/20, 70/20/10, 6 jarras) ---

enum GrupoGasto {
    NECESIDADES
    DESEOS
    EDUCACION
    AHORRO
    INVERSION
    DONACIONES
}

enum PlantillaRegla {
    REGLA_70_20_10
    REGLA_50_30_20
    SEIS_JARRAS
    PERSONALIZADA
}

type PorcentajeGrupo {
    grupo: GrupoGasto!
    porcentaje: Float!
}

input PorcentajeGrupoInput {
    grupo: GrupoGasto!
    porcentaje: Float!
}

type ReglaPresupuesto {
    plantilla: PlantillaRegla!
    porcentajes: [PorcentajeGrupo!]!
}

type PartidaDistribucion {
    clave: String!
    nombre: String!
    porcentaje: Float!
    grupos: [GrupoGasto!]!
    montoRecomendado: Float!
    montoReal: Float!
    porcentajeReal: Float!
    esAhorro: Boolean!
}

type DistribucionRegla {
    activa: Boolean!
    plantilla: PlantillaRegla!
    plantillaSugerida: PlantillaRegla
    ingresoMensual: Float!
    partidas: [PartidaDistribucion!]!
    montoSinClasificar: Float!
    categoriasSinClasificar: Int!
}

type PresupuestoSugerido {
    categoria: Categoria!
    partida: String!
    montoSugerido: Float!
    # Lo gastado en la categoría (el mayor entre el mes anterior y el actual).
    montoReferencia: Float!
    montoActual: Float
}

input PresupuestoInput {
    categoriaId: ID!
    monto: Float!
}

type Query {
    getAllGastos(mes: Int, anio: Int): [Gasto]!
    getAllPersonas: [Persona]!
    getAllIngresos(mes: Int, anio: Int): [Ingreso]!
    getAllAhorros(mes: Int, anio: Int): [Ahorro]!
    getGlobalBalance(mes: Int, anio: Int): Float!
    getAllCategorias(tipo: String): [Categoria]!
    getLastRecordsDates: LastRecordsDates!
    generarReporteMensual(mes: Int!, anio: Int!): String!
    getPagosCompartidos(gastoId: ID!): [PagoCompartido]!
    getShoppingList: [Compra]!
    getPresupuestos(mes: Int!, anio: Int!): [Presupuesto]!

    getReglaPresupuesto: ReglaPresupuesto
    getDistribucionRegla(mes: Int!, anio: Int!): DistribucionRegla!
    getPresupuestosSugeridos(mes: Int!, anio: Int!): [PresupuestoSugerido!]!
}

type Mutation {
    createGasto(amount: Float!, categoriaId: ID!, date: String!, description: String, personaId: ID!, formaPago: String, recurrent: Boolean, pagado: Boolean, fechaVencimiento: String, esCompartido: Boolean, cuotaActual: Int, cuotasTotales: Int): Gasto!
    updateGasto(id: ID!, amount: Float, categoriaId: ID, date: String, description: String, personaId: ID, formaPago: String, recurrent: Boolean, pagado: Boolean, fechaVencimiento: String, esCompartido: Boolean, cuotaActual: Int, cuotasTotales: Int): Gasto!
    deleteGasto(id: ID!): Boolean!
    createPersona(nombre: String!): Persona!
    updatePersona(id: ID!, nombre: String, activo: Boolean): Persona
    createIngreso(monto: Float!, fecha: String!, categoriaId: ID!, personaId: ID!, recurrent: Boolean): Ingreso!
    createAhorro(monto: Float!, fecha: String!, personaId: ID, descripcion: String): Ahorro!
    deleteAhorro(id: ID!): Boolean!
    finalizarMes(mesActual: Int!, anioActual: Int!): CierreResult!
    pagarGasto(id: ID!, monto: Float!, personaId: ID!, formaPago: String!, fechaPago: String!): Gasto!
    reiniciarDatos: Boolean
    createCategoria(nombre: String!, icono: String, tipo: String!, grupo: GrupoGasto): Categoria!
    deleteCategoria(id: ID!): Boolean!
    updateCategoria(id: ID!, nombre: String, icono: String, tipo: String, grupo: GrupoGasto): Categoria
    agregarPagoCompartido(gastoId: ID!, personaId: ID!, monto: Float!, formaPago: String!, fecha: String): PagoCompartido!
    login(nombre: String!, clave: String!): LoginResult
    setClave(id: ID!, clave: String!): Persona

    createShoppingItem(nombre: String!, precio: Float, lugar: String): Compra!
    toggleShoppingItemStatus(id: ID!): Compra!
    deleteShoppingItem(id: ID!): Boolean!

    setPresupuesto(categoriaId: ID!, monto: Float!, mes: Int!, anio: Int!): Presupuesto!

    # La plantilla personalizada exige porcentajes que sumen 100; las fijas los ignoran.
    guardarReglaPresupuesto(plantilla: PlantillaRegla!, porcentajes: [PorcentajeGrupoInput!]): ReglaPresupuesto!
    desactivarReglaPresupuesto: Boolean!
    # Guarda solo los presupuestos que el usuario confirmó; se aplican todos o ninguno.
    aplicarPresupuestos(mes: Int!, anio: Int!, presupuestos: [PresupuestoInput!]!): [Presupuesto!]!
}

